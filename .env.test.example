APP_NAME=Interloid Task Manager
APP_VERSION=1.0.0

HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO


DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fastapi_test_db
DB_SSL=false

REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_KEY_PREFIX=login_rate_limit_test  

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=example-user
SMTP_PASSWORD=example-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true


OTP_SECRET_KEY=test-otp-secret-key-at-least-32-characters

EMAIL_OTP_EXPIRE_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS = 60

JWT_SECRET_KEY=change-this-test-secret-key-minimum-32-characters
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
