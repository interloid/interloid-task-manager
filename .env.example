APP_NAME=Interloid Task Manager
APP_VERSION=0.1.0

DEBUG=True
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

DB_HOST=localhost
DB_PORT=5433
DB_NAME=fastapi_db
DB_USER=postgres
DB_PASSWORD=password
DB_SSL=true

REDIS_URL=rediss://default:<password>@<host>:<port>
REDIS_KEY_PREFIX=login_rate_limit_prod

GOOGLE_CLIENT_ID=your_actual_client_id
GOOGLE_CLIENT_SECRET=your_actual_client_secret
GOOGLE_REDIRECT_URI=your_redirect_url

SECRET_KEY=your_generated_secret_key

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

AWS_ACCESS_KEY_ID=your_secret_aws_acess_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=interloid-task-manager-attachments-2026
S3_PRESIGNED_URL_EXPIRE_SECONDS=300

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=example-user
SMTP_PASSWORD=example-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

OTP_SECRET_KEY=test-otp-secret-key-at-least-32-characters

EMAIL_OTP_EXPIRE_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60

PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS = 60

JWT_SECRET_KEY=this-is-a-fake-jwt-secret-key-for-local-development-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
